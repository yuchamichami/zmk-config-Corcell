#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/runtime-input-processor.dtsi>

/ {
    macros {
        // Keep layer activation momentary while exposing physical down/up to HID testers.
        layer_1_signal: layer_1_signal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "Layer 1 + F22";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 1 &kp F22>,
                       <&macro_pause_for_release>,
                       <&macro_release &kp F22 &mo 1>;
        };

        // Keep layer activation momentary while exposing physical down/up to HID testers.
        layer_2_signal: layer_2_signal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "Layer 2 + F23";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 2 &kp F23>,
                       <&macro_pause_for_release>,
                       <&macro_release &kp F23 &mo 2>;
        };

        // Keep layer activation momentary while exposing physical down/up to HID testers.
        layer_3_signal: layer_3_signal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "Layer 3 + F24";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 3 &kp F24>,
                       <&macro_pause_for_release>,
                       <&macro_release &kp F24 &mo 3>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &lt 5 I  &kp O  &kp P  &kp BSPC
&kp TAB  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp COLON  &kp RET
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N9  &kp N8  &kp N  &kp M  &kp COMMA  &kp DOT  &kp UP  &kp QMARK
&kp LCTRL  &kp LGUI  &kp LALT  &layer_1_signal  &layer_2_signal  &kp SPACE  &kp SPACE  &layer_3_signal  &lt 5 A  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_1 {
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_7  &kp N8  &kp NUMBER_9  &kp NUMBER_0  &trans
&trans  &trans  &kp DOUBLE_QUOTES  &kp SEMICOLON  &kp SLASH  &kp MINUS  &kp KP_PLUS  &kp EQUAL  &kp DOUBLE_QUOTES  &kp SQT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Connection controls are reachable using only the central (right) half.
        layer_3 {
            bindings = <
&studio_unlock  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR  &out OUT_USB  &out OUT_BLE  &trans  &trans  &bt BT_SEL 0
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 1
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 2
&trans  &trans  &trans  &trans  &trans  &trans  &none  &trans  &studio_unlock  &trans  &trans  &bt BT_SEL 3
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
